    "Guardati %lld file: nessuno è un programma o un documento classico senza icona. I file che ce l'hanno già non si toccano.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Looked at %lld files: none is a classic program or document without an icon. Files that already have one are left alone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld fichiers examinés : aucun n'est un programme ou un document classique sans icône. Les fichiers qui en ont déjà une ne sont pas touchés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Dateien geprüft: Keine ist ein klassisches Programm oder Dokument ohne Symbol. Dateien, die bereits eines haben, bleiben unberührt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se revisaron %lld archivos: ninguno es un programa o documento clásico sin icono. Los que ya tienen uno no se tocan."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم فحص %lld ملفات: لا يوجد بينها برنامج أو مستند قديم بلا أيقونة. الملفات التي لها أيقونة بالفعل لا تُمَسّ."
          }
        }
      }
    },
    "Guardo i file di «%@»": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Looking at the files on “%@”"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Examen des fichiers de « %@ »"
          }
        },
        "de": {
