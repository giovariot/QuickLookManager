{
  "sourceLanguage": "it",
  "strings": {
    "%lld di %lld file": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld of %lld files"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld sur %lld fichiers"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld von %lld Dateien"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld de %lld archivos"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld من %lld ملفات"
          }
        }
      }
    },
    "%lld dpi": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld dpi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ppp"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld dpi"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ppp"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld نقطة في البوصة"
          }
        }
      }
    },
    "%lld file di «%@» hanno l'icona nuova.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld files on “%@” have the new icon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld fichiers de « %@ » ont la nouvelle icône."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Dateien auf „%@“ haben das neue Symbol."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld archivos de «%@» tienen el icono nuevo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ملفات على «%@» لها الأيقونة الجديدة."
          }
        }
      }
    },
    "%lld file di «%@» non hanno più l'icona.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld files on “%@” no longer have the icon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld fichiers de « %@ » n'ont plus l'icône."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Dateien auf „%@“ haben das Symbol nicht mehr."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld archivos de «%@» ya no tienen el icono."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تعد %lld ملفات على «%@» تحمل الأيقونة."
          }
        }
      }
    },
    "%lld file erano stati modificati dopo l'icona: il loro contenuto non è stato toccato, è stato tolto solo il segno dell'icona.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld files had been modified after the icon: their content was not touched, only the icon marker was removed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld fichiers avaient été modifiés après l'icône : leur contenu n'a pas été touché, seul le repère d'icône a été retiré."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Dateien waren nach dem Symbol geändert worden: Ihr Inhalt blieb unberührt, nur die Symbolmarkierung wurde entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld archivos se habían modificado después del icono: su contenido no se ha tocado, solo se quitó la marca del icono."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كان %lld ملفات قد عُدّلت بعد الأيقونة: لم يُمَسّ محتواها، وأُزيلت علامة الأيقونة فقط."
          }
        }
      }
    },
    "%lld file guardati, %lld con l'icona nuova": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld files looked at, %lld with a new icon"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld fichiers examinés, %lld avec une nouvelle icône"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Dateien geprüft, %lld mit neuem Symbol"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld archivos revisados, %lld con icono nuevo"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم فحص %lld ملفات، %lld منها بأيقونة جديدة"
          }
        }
      }
    },
    "%lld file sono già tornati com'erano; gli altri restano nell'elenco e puoi riprendere quando vuoi.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld files are already back to how they were; the rest stay in the list and you can resume whenever you like."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld fichiers sont déjà revenus à leur état d'origine ; les autres restent dans la liste et vous pouvez reprendre quand vous voulez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Dateien sind bereits im Ursprungszustand; die übrigen bleiben in der Liste und Sie können jederzeit fortfahren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld archivos ya han vuelto a como estaban; los demás siguen en la lista y puedes reanudar cuando quieras."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عادت %lld ملفات إلى حالتها الأصلية؛ وتبقى البقية في القائمة ويمكنك المتابعة متى شئت."
          }
        }
      }
    },
    "%lld sono tornati com'erano.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld went back to how they were."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld sont revenus à leur état d'origine."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld wurden in den Ursprungszustand zurückversetzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld han vuelto a como estaban."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عادت %lld ملفات إلى حالتها الأصلية."
          }
        }
      }
    },
    "%lld spazi": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld spaces"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld espaces"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Leerzeichen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld espacios"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld مسافات"
          }
        }
      }
    },
    "%lld sì. L'elenco dei fork originali resta dov'è, così si può riprovare.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld did. The list of original forks stays where it is, so you can try again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld oui. La liste des forks d'origine reste en place, vous pouvez donc réessayer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld schon. Die Liste der ursprünglichen Forks bleibt erhalten, sodass Sie es erneut versuchen können."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld sí. La lista de forks originales se queda donde está, así que se puede reintentar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ملفات عادت. تبقى قائمة الفروع الأصلية في مكانها لتتمكن من المحاولة مجددًا."
          }
        }
      }
    },
    ", e mi sono fermato al tetto di %lld.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": ", and stopped at the limit of %lld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": ", et arrêté à la limite de %lld."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " und bei der Grenze von %lld angehalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": ", y me detuve en el límite de %lld."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "، وتوقفت عند الحد %lld."
          }
        }
      }
    },
    ", e mi sono fermato perché me l'hai chiesto.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": ", and stopped because you asked me to."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": ", et arrêté à votre demande."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " und auf Ihren Wunsch angehalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": ", y me detuve porque lo pediste."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "، وتوقفت لأنك طلبت ذلك."
          }
        }
      }
    },
