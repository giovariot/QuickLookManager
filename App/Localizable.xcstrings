    "Di solito no: un disco condiviso si legge piano e non è tuo.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Usually not: a shared disk is slow to read and isn't yours."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En général non : un disque partagé se lit lentement et n'est pas le vôtre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meist nicht: Ein freigegebener Datenträger ist langsam und gehört nicht Ihnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Normalmente no: un disco compartido se lee despacio y no es tuyo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عادةً لا: القرص المشترك بطيء في القراءة وليس ملكك."
          }
        }
      }
    },
