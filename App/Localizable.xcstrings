          }
        }
      }
    },
    "Vedrai l'anteprima di Quick Look: se QuickLook Manager è attivo, è quella dei suoi moduli.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'll see the Quick Look preview: if QuickLook Manager is active, it comes from its modules."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous verrez l'aperçu Quick Look : si QuickLook Manager est actif, il vient de ses modules."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie sehen die Quick-Look-Vorschau: Ist QuickLook Manager aktiv, stammt sie aus seinen Modulen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Verás la vista previa de Quick Look: si QuickLook Manager está activo, procede de sus módulos."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سترى معاينة Quick Look: إن كان QuickLook Manager مفعّلًا فهي قادمة من وحداته."
          }
        }
      }
    },
