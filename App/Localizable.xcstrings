    "Canon (CR2, CR3, CRW), Nikon (NEF, NRW), Sony (ARW, SR2), Fujifilm (RAF), Olympus (ORF), Panasonic (RW2), Pentax, Leica, Hasselblad, Phase One, Samsung, Adobe DNG e altri. Letti con LibRaw, incorporata nell'app.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Canon (CR2, CR3, CRW), Nikon (NEF, NRW), Sony (ARW, SR2), Fujifilm (RAF), Olympus (ORF), Panasonic (RW2), Pentax, Leica, Hasselblad, Phase One, Samsung, Adobe DNG and more. Read with LibRaw, built into the app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Canon (CR2, CR3, CRW), Nikon (NEF, NRW), Sony (ARW, SR2), Fujifilm (RAF), Olympus (ORF), Panasonic (RW2), Pentax, Leica, Hasselblad, Phase One, Samsung, Adobe DNG et autres. Lus avec LibRaw, intégrée à l'app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Canon (CR2, CR3, CRW), Nikon (NEF, NRW), Sony (ARW, SR2), Fujifilm (RAF), Olympus (ORF), Panasonic (RW2), Pentax, Leica, Hasselblad, Phase One, Samsung, Adobe DNG und weitere. Gelesen mit LibRaw, in die App eingebaut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Canon (CR2, CR3, CRW), Nikon (NEF, NRW), Sony (ARW, SR2), Fujifilm (RAF), Olympus (ORF), Panasonic (RW2), Pentax, Leica, Hasselblad, Phase One, Samsung, Adobe DNG y otros. Se leen con LibRaw, incluida en la app."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Canon (CR2 وCR3 وCRW) وNikon (NEF وNRW) وSony (ARW وSR2) وFujifilm (RAF) وOlympus (ORF) وPanasonic (RW2) وPentax وLeica وHasselblad وPhase One وSamsung وAdobe DNG وغيرها. تُقرأ بواسطة LibRaw المدمجة في التطبيق."
          }
        }
      }
    },
