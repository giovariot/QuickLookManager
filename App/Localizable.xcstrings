    "Un agente in background guarda i dischi che colleghi e dà l'icona ai programmi e ai documenti classici. Scrive solo sui dischi per cui hai dato il permesso.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A background agent watches the disks you connect and gives icons to classic programs and documents. It only writes to disks you have allowed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un agent en arrière-plan surveille les disques que vous branchez et donne une icône aux programmes et documents classiques. Il n'écrit que sur les disques que vous avez autorisés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Hintergrundagent beobachtet die angeschlossenen Datenträger und vergibt Symbole für klassische Programme und Dokumente. Er schreibt nur auf Datenträger, die Sie erlaubt haben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un agente en segundo plano vigila los discos que conectas y da icono a los programas y documentos clásicos. Solo escribe en los discos que hayas permitido."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وكيل يعمل في الخلفية يراقب الأقراص التي توصلها ويمنح أيقونات للبرامج والمستندات القديمة. يكتب فقط على الأقراص التي سمحت بها."
          }
        }
      }
    },
    "Usato quando l'estensione non indica un linguaggio noto.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used when the file extension doesn't indicate a known language."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisé quand l'extension du fichier n'indique pas un langage connu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird verwendet, wenn die Dateiendung keine bekannte Sprache angibt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usa cuando la extensión del archivo no indica un lenguaje conocido."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُستخدم عندما لا يدل امتداد الملف على لغة معروفة."
          }
        }
      }
    },
    "Vai a capo automaticamente": {
      "extractionState": "manual",
      "localizations": {
