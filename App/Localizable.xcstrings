    "Su «%@» %lld file non sono tornati com'erano.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On “%@” %lld files did not go back to how they were."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur « %@ », %lld fichiers ne sont pas revenus à leur état d'origine."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf „%@“ wurden %lld Dateien nicht in den Ursprungszustand zurückversetzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En «%@», %lld archivos no han vuelto a como estaban."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على «%@» لم تعد %lld ملفات إلى حالتها الأصلية."
          }
        }
      }
    },
    "Su «%@» nessuna icona è stata scritta.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No icon was written on “%@”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune icône n'a été écrite sur « %@ »."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf „%@“ wurde kein Symbol geschrieben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se escribió ningún icono en «%@»."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تُكتب أي أيقونة على «%@»."
          }
        }
      }
    },
    "Su «%@» non c'era niente da fare.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing to do on “%@”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien à faire sur « %@ »."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf „%@“ gibt es nichts zu tun."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay nada que hacer en «%@»."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا شيء لفعله على «%@»."
          }
        }
      }
    },
    "Su «%@» non c'è niente da rimettere a posto.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing to restore on “%@”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien à rétablir sur « %@ »."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf „%@“ gibt es nichts wiederherzustellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay nada que restaurar en «%@»."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا شيء لاستعادته على «%@»."
          }
        }
      }
    },
    "Su «%@» non si può scrivere.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” can't be written to."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'écrire sur « %@ »."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf „%@“ kann nicht geschrieben werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede escribir en «%@»."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن الكتابة على «%@»."
          }
        }
      }
    },
    "Sviluppa il RAW se non ha un'anteprima incorporata": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Develop the RAW if it has no embedded preview"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Développer le RAW s'il n'a pas d'aperçu intégré"
          }
