    "Scegli il disco a cui dare le icone dei file classici.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the disk whose classic files should get their icons."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez le disque dont les fichiers classiques doivent recevoir leur icône."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie den Datenträger, dessen klassische Dateien ihre Symbole erhalten sollen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige el disco cuyos archivos clásicos deben recibir su icono."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر القرص الذي ستحصل ملفاته القديمة على أيقوناتها."
          }
        }
      }
    },
    "Scegli il disco di cui rimettere a posto i fork originali.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the disk whose original forks should be restored."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez le disque dont il faut rétablir les forks d'origine."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie den Datenträger, dessen ursprüngliche Forks wiederhergestellt werden sollen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige el disco cuyos forks originales se deben restaurar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر القرص الذي تُستعاد فروعه الأصلية."
          }
        }
      }
    },
    "Scegli un file…": {
