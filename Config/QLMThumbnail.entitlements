<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key> <true/>
	<key>com.apple.security.files.user-selected.read-only</key> <true/>
	<!--
	  Impostazioni e fogli di stile scelti dall'utente: li scrive l'app (non in sandbox) in
	  ~/Library/Application Support/QuickLookManager/ e le estensioni li leggono soltanto.
	  Niente App Group: servirebbe un profilo di provisioning, e la distribuzione e' solo su GitHub.
	-->
	<key>com.apple.security.temporary-exception.files.home-relative-path.read-only</key>
	<array>
		<string>/Library/Application Support/QuickLookManager/</string>
	</array>
	<!-- JavaScriptCore con JIT: l'evidenziazione di file grandi resta veloce. -->
	<key>com.apple.security.cs.allow-jit</key> <true/>
</dict>
</plist>
