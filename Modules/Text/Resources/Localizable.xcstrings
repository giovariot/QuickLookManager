    "Pacchetti di installazione: in alto identificatore, versione, script e firma; in basso l'elenco dei file che installa, senza scompattarli.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installer packages: identifier, version, scripts and signature at the top; the list of files it installs at the bottom, without unpacking them."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paquets d'installation : identifiant, version, scripts et signature en haut ; liste des fichiers installés en bas, sans les décompresser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installationspakete: oben Kennung, Version, Skripte und Signatur; unten die Liste der installierten Dateien, ohne sie zu entpacken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Paquetes de instalación: arriba identificador, versión, scripts y firma; abajo la lista de archivos que instala, sin descomprimirlos."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حزم التثبيت: في الأعلى المعرّف والإصدار والسكربتات والتوقيع، وفي الأسفل قائمة الملفات التي تثبّتها دون فكّ ضغطها."
          }
        }
      }
    },
