          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperçu 3D interactif et miniatures des fichiers 3MF, avec SceneKit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Interaktive 3D-Vorschau und Miniaturen von 3MF-Dateien mit SceneKit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vista previa 3D interactiva y miniaturas de archivos 3MF, con SceneKit."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "معاينة ثلاثية الأبعاد تفاعلية ومصغّرات لملفات 3MF باستخدام SceneKit."
          }
        }
      }
    },
    "Anteprima e miniature dei file EPS: l'immagine incorporata o, se manca, il disegno reso con Ghostscript.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Previews and thumbnails of EPS files: the embedded image or, if there isn't one, the drawing rendered with Ghostscript."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperçus et miniatures des fichiers EPS : l'image intégrée ou, à défaut, le dessin rendu avec Ghostscript."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorschauen und Miniaturen von EPS-Dateien: das eingebettete Bild oder, falls keines vorhanden ist, die mit Ghostscript gezeichnete Grafik."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vistas previas y miniaturas de archivos EPS: la imagen incrustada o, si no hay, el dibujo generado con Ghostscript."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "معاينات ومصغّرات لملفات EPS: الصورة المضمّنة أو، إن لم توجد، الرسم الذي يولّده Ghostscript."
          }
        }
      }
    },
    "Anteprima e miniature delle foto RAW, usando l'immagine incorporata nel file, letta con LibRaw.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Previews and thumbnails of RAW photos, using the image embedded in the file, read with LibRaw."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperçus et miniatures des photos RAW, à partir de l'image intégrée au fichier, lue avec LibRaw."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorschauen und Miniaturen von RAW-Fotos anhand des in der Datei eingebetteten Bildes, gelesen mit LibRaw."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vistas previas y miniaturas de fotos RAW, a partir de la imagen incrustada en el archivo, leída con LibRaw."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "معاينات ومصغّرات لصور RAW باستخدام الصورة المضمّنة في الملف وتُقرأ بواسطة LibRaw."
          }
        }
      }
    },
