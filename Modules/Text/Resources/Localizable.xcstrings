    "Albero e sorgente XML, anche per le plist binarie.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tree and XML source, including binary plists."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arbre et source XML, y compris pour les plist binaires."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Baum und XML-Quelltext, auch für binäre Plists."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Árbol y código fuente XML, también para plist binarias."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شجرة ومصدر XML، حتى لملفات plist الثنائية."
          }
        }
      }
    },
    "Albero e sorgente; commenti e virgole finali tollerati.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tree and source; comments and trailing commas are tolerated."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arbre et source ; commentaires et virgules finales tolérés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Baum und Quelltext; Kommentare und nachgestellte Kommas werden toleriert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Árbol y código fuente; se toleran comentarios y comas finales."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شجرة ومصدر؛ يُسمح بالتعليقات والفواصل الأخيرة."
          }
        }
      }
    },
    "Albero e sorgente; più documenti separati da ---.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tree and source; multiple documents separated by --- are supported."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arbre et source ; plusieurs documents séparés par --- sont pris en charge."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Baum und Quelltext; mehrere durch --- getrennte Dokumente werden unterstützt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Árbol y código fuente; se admiten varios documentos separados por ---."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شجرة ومصدر؛ تُدعم عدة مستندات مفصولة بـ ---."
          }
        }
      }
    },
