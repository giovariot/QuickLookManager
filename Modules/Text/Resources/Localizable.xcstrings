    "Non è un pacchetto «flat» (xar): i pacchetti in formato cartella non sono supportati.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This isn't a “flat” (xar) package: folder-style packages are not supported."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce n'est pas un paquet « flat » (xar) : les paquets sous forme de dossier ne sont pas pris en charge."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist kein „flaches“ Paket (xar): Pakete in Ordnerform werden nicht unterstützt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No es un paquete «flat» (xar): los paquetes en formato carpeta no se admiten."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه ليست حزمة «مسطّحة» (xar): الحزم بصيغة المجلدات غير مدعومة."
