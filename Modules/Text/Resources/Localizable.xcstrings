    "Codifica rilevata automaticamente; .nfo, .diz e simili come DOS (CP437).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Encoding is detected automatically; .nfo, .diz and similar are read as DOS (CP437)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Encodage détecté automatiquement ; .nfo, .diz et similaires sont lus en DOS (CP437)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zeichenkodierung wird automatisch erkannt; .nfo, .diz und ähnliche werden als DOS (CP437) gelesen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La codificación se detecta automáticamente; .nfo, .diz y similares se leen como DOS (CP437)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُكتشف الترميز تلقائيًا؛ وتُقرأ ملفات .nfo و.diz وما شابهها بترميز DOS (CP437)."
          }
        }
      }
    },
